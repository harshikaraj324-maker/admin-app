<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingBottom="8dp">

    <!-- Top blue bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#0E5271" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_margin="8dp"
        android:background="@drawable/box_border_bg"
        android:elevation="4dp"
        android:clipToPadding="false">

        <!-- Sent & Received (GraphView removed, text fills full width) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/sentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sent: 0 B"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receivedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Received: 0 B"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Socket Connection Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/socketStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/red_circle"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/socketStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Socket: Disconnected"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/socketRefreshBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="⟳"
                android:textSize="22sp"
                android:textColor="#0E5271"
                android:gravity="center"
                android:background="@drawable/box_border_bg"
                android:padding="4dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Total, Last 15min & Check Online -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:weightSum="3">

            <TextView
                android:id="@+id/totalCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: --"
                android:textColor="#0A80DE"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/last15MinSeen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last 15min: --"
                android:textColor="#4CAF50"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/checkOnlineText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/orange_rounded_button"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Check Online"
                android:textColor="#FF9800"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#999999"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/allMessagesTextView"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ALL MESSAGES"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/blue_rounded_button"
                android:layout_marginEnd="8dp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/updateNoTextView"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="UPDATE NO"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/blue_rounded_button"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.05" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
